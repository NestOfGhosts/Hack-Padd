#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        0 {
            bindings = <
                &kp LA(TAB) &kp LG(D) &kp LC(LS(ESC))
                &kp C_PREV &kp C_PP &kp C_NEXT
                &kp LC(C) &kp LC(X) &kp LC(V)
                &kp LC(Z) &kp LC(Y) &mo 1
            >;
        };
        1 {
            bindings = <
                &kp 13 &kp 14 &kp 15
                &kp 16 &kp 17 &kp 18
                &kp 19 &kp 20 &kp 21
                &mo 2 &trans &trans
            >;
        };
        2 {
            bindings = <
                &bootloader &trans &trans
                &trans &trans &trans 
                &soft_off &trans &trans
                &trans &trans &trans 
            >;
        };
    };
};